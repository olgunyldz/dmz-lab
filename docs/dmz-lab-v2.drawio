        <mxCell id="p10_c8" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p10_c6" target="p10_c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c9" value="Spring IdP&lt;br&gt;[identity]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="410" y="40" width="170" height="64" as="geometry"/></mxCell>
        <mxCell id="p10_c10" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="696" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c11" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p10_c9" target="p10_c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c12" value="ext-authz&lt;br&gt;[DMZ auth]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="170" height="64" as="geometry"/></mxCell>
        <mxCell id="p10_c13" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="696" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c14" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p10_c12" target="p10_c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c15" value="seal-mobile&lt;br&gt;[DMZ · mock]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="790" y="40" width="170" height="64" as="geometry"/></mxCell>
        <mxCell id="p10_c16" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="696" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c17" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p10_c15" target="p10_c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c18" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="129" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c19" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="129" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c20" value="1. web girişi tamamlandı: web token (channel=web)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c18" target="p10_c19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c21" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="175" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c22" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="175" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c23" value="2. mobil girişi tamamlandı: mobil token (DPoP)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c21" target="p10_c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c24" value="3. yeni authorization_code girişi → alice'in web oturumu SİLİNİR" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="501" y="208" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p10_c25" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="267" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c26" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="267" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c27" value="4. GET /bff/web/accounts  eski web token" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c25" target="p10_c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c28" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c29" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c30" value="5. token exchange (subject = eski web token)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c28" target="p10_c29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c31" value="6. subject için oturum kaydı YOK" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="501" y="346" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p10_c32" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="405" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c33" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="405" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c34" value="7. 400 invalid_grant (oturum sonlanmış)" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c32" target="p10_c33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c35" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c36" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c37" value="8. 403 forbidden → web giriş ekranı" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c35" target="p10_c36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c38" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c39" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c40" value="9. login/begin  eski mobil token (başka cihazda aynı kullanıcı)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c38" target="p10_c39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c41" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="543" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c42" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="543" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c43" value="10. introspection (eski mobil token)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c41" target="p10_c42"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c44" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c45" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c46" value="11. active=false" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c44" target="p10_c45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c47" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="635" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c48" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="635" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p10_c49" value="12. 401 oturum sonlanmış" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p10_c47" target="p10_c48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p10_c50" value="KURAL: aynı kullanıcı için tek aktif giriş; son giriş kazanır. Client credentials (servis) oturumları etkilenmez.&lt;br&gt;LAB → PROD: introspection önbelleği yok (doğruluk); yük için Redis tabanlı sid modeli ileride." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="890" height="76" as="geometry"/></mxCell>
        <mxCell id="p10_c51" value="Adım legend'ı&lt;br&gt;1. [Web uygulama] -&gt; [Spring IdP]: 1. web girişi tamamlandı: web token (channel=web)&lt;br&gt;2. [Mobil uygulama] -&gt; [Spring IdP]: 2. mobil girişi tamamlandı: mobil token (DPoP)&lt;br&gt;3. [Spring IdP] kendi içinde: 3. yeni authorization_code girişi → alice'in web oturumu SİLİNİR&lt;br&gt;4. [Web uygulama] -&gt; [ext-authz]: 4. GET /bff/web/accounts  eski web token&lt;br&gt;5. [ext-authz] -&gt; [Spring IdP]: 5. token exchange (subject = eski web token)&lt;br&gt;6. [Spring IdP] kendi içinde: 6. subject için oturum kaydı YOK&lt;br&gt;7. [Spring IdP] -&gt; [ext-authz]: 7. 400 invalid_grant (oturum sonlanmış)&lt;br&gt;8. [ext-authz] -&gt; [Web uygulama]: 8. 403 forbidden → web giriş ekranı&lt;br&gt;9. [Mobil uygulama] -&gt; [seal-mobile]: 9. login/begin  eski mobil token (başka cihazda aynı kullanıcı)&lt;br&gt;10. [seal-mobile] -&gt; [Spring IdP]: 10. introspection (eski mobil token)&lt;br&gt;11. [Spring IdP] -&gt; [seal-mobile]: 11. active=false&lt;br&gt;12. [seal-mobile] -&gt; [Mobil uygulama]: 12. 401 oturum sonlanmış" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="1000" height="218" as="geometry"/></mxCell>
        <mxCell id="p10_c52" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p11" name="VR1 Login aktif cihaz">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="NaN" pageHeight="2556" math="0" shadow="0">
      <root>
