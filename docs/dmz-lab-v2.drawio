        <mxCell id="p5_c29" value="3. active=true, sub=alice" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c27" target="p5_c28"><mxGeometry relative="1" as="geometry"/></mxCell>
