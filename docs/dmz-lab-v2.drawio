        <mxCell id="p3_c19" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="129" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c20" value="1. GET /realms/bank/.../auth  client_id=mobile-app  code_challenge (S256)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c18" target="p3_c19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c21" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="175" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c22" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="175" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c23" value="2. TLS re-encrypt (mTLS iç CA)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c21" target="p3_c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c24" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="221" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c25" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="221" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c26" value="3. route /realms/ (mobile-login)  mTLS" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c24" target="p3_c25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c27" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="267" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c28" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="267" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c29" value="4. authorization endpoint" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c27" target="p3_c28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c30" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c31" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c32" value="5. 302 /login (oturum çerezi)" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c30" target="p3_c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c33" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="359" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c34" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="359" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c35" value="6. POST /login  username=alice  parola (YALNIZ IdP'de)  _csrf" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c33" target="p3_c34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c36" value="7. parola BCrypt doğrula (JdbcUserDetailsManager)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="881" y="392" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p3_c37" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c38" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c39" value="8. 302 → code  (com.bank.app:/callback?code=...)" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c37" target="p3_c38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c40" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c41" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c42" value="9. POST /token  code + code_verifier  DPoP: &lt;proof, jwk&gt;" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c40" target="p3_c41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c43" value="10. DpopRequiredFilter: proof zorunlu; cnf.jkt = proof anahtarı" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="881" y="530" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p3_c44" value="11. TEK AKTİF GİRİŞ: alice'in diğer authorization_code oturumları silinir" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="881" y="576" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p3_c45" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="635" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c46" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="635" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p3_c47" value="12. access_token (channel=mobile, aud=channel-mobile, cnf.jkt) + refresh" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p3_c45" target="p3_c46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_c48" value="KONTROLLER: K1 parola yalnız IdP'de; Seal ve mobil uygulama parola görmez. K2 DPoP: token anahtara bağlı (cnf.jkt). K3 yeni giriş eski kanal oturumunu düşürür.&lt;br&gt;LAB → PROD: PKCE ve DPoP lab'da; attestation (App Attest / Play Integrity) yok. Mobil redirect (com.bank.app) prod'da uygulama bağlantısı doğrulamalı." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="890" height="76" as="geometry"/></mxCell>
        <mxCell id="p3_c49" value="Adım legend'ı&lt;br&gt;1. [Mobil uygulama] -&gt; [HAProxy]: 1. GET /realms/bank/.../auth  client_id=mobile-app  code_challenge (S256)&lt;br&gt;2. [HAProxy] -&gt; [kgateway gw-mobile]: 2. TLS re-encrypt (mTLS iç CA)&lt;br&gt;3. [kgateway gw-mobile] -&gt; [kgateway gw-internal]: 3. route /realms/ (mobile-login)  mTLS&lt;br&gt;4. [kgateway gw-internal] -&gt; [Spring IdP]: 4. authorization endpoint&lt;br&gt;5. [Spring IdP] -&gt; [Mobil uygulama]: 5. 302 /login (oturum çerezi)&lt;br&gt;6. [Mobil uygulama] -&gt; [Spring IdP]: 6. POST /login  username=alice  parola (YALNIZ IdP'de)  _csrf&lt;br&gt;7. [Spring IdP] kendi içinde: 7. parola BCrypt doğrula (JdbcUserDetailsManager)&lt;br&gt;8. [Spring IdP] -&gt; [Mobil uygulama]: 8. 302 → code  (com.bank.app:/callback?code=...)&lt;br&gt;9. [Mobil uygulama] -&gt; [Spring IdP]: 9. POST /token  code + code_verifier  DPoP: &lt;proof, jwk&gt;&lt;br&gt;10. [Spring IdP] kendi içinde: 10. DpopRequiredFilter: proof zorunlu; cnf.jkt = proof anahtarı&lt;br&gt;11. [Spring IdP] kendi içinde: 11. TEK AKTİF GİRİŞ: alice'in diğer authorization_code oturumları silinir&lt;br&gt;12. [Spring IdP] -&gt; [Mobil uygulama]: 12. access_token (channel=mobile, aud=channel-mobile, cnf.jkt) + refresh" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="1000" height="218" as="geometry"/></mxCell>
        <mxCell id="p3_c50" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
