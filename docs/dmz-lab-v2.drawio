        <mxCell id="p6_c11" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p6_c9" target="p6_c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6_c12" value="ext-authz&lt;br&gt;[DMZ auth]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="170" height="64" as="geometry"/></mxCell>
