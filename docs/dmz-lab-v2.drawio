        <mxCell id="p6_c68" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1254" y="911" width="2" height="2" as="geometry"/></mxCell>
