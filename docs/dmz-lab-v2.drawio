        <mxCell id="p7_c87" value="25. PM pin/set (gw-internal)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p7_c85" target="p7_c86"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7_c88" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="1279" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c89" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="1279" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c90" value="26. POST /activation/complete  {activationToken}" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p7_c88" target="p7_c89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7_c91" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="1325" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c92" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="1325" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c93" value="27. POST /internal/auth/activation/complete" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p7_c91" target="p7_c92"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7_c94" value="28. device_activation: ACTIVATED; bekleyen aktivasyon listesinden çıkar" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="691" y="1358" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p7_c95" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="1417" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c96" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="1417" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p7_c97" value="29. ACTIVATED  (sonraki token'lar kısıtsız)" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p7_c95" target="p7_c96"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7_c98" value="KONTROLLER: K1 yeni cihaz PIN'i doğrulanmadan OTP'ye yönlenir. K2 OTP 5 denemede kilit; kullanıcı başına OTP talebi 20 / 10 dk. K3 kısıtlı token iş API'lerinde 403.&lt;br&gt;LAB → PROD: OTP demo (ekranda); prod'da SMS/push sağlayıcısı. Aktivasyon token'ı kullanıcıya bağlı; cihaz kaydı yalnız IdP token'ı ister (MFA şartı prod'da)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1488" width="1080" height="76" as="geometry"/></mxCell>
        <mxCell id="p7_c99" value="Adım legend'ı&lt;br&gt;1. [Mobil uygulama] -&gt; [seal-mobile]: 1. POST /login/begin → /login/pin  {pin}  (kayıtsız cihaz; PIN doğrulanmaz)&lt;br&gt;2. [seal-mobile] -&gt; [kgateway gw-internal]: 2. POST /internal/auth/flow/update  {NEW_DEVICE, newDevice=true}&lt;br&gt;3. [kgateway gw-internal] -&gt; [Spring IdP]: 3. /internal/auth/* (HTTPS, CN=gw-internal)&lt;br&gt;4. [seal-mobile] -&gt; [kgateway gw-internal]: 4. POST /internal/auth/device/new  {username, flowId}&lt;br&gt;5. [kgateway gw-internal] -&gt; [Spring IdP]: 5. device/new  (throttle: kullanıcı başına 20 / 10 dk)&lt;br&gt;6. [Spring IdP] kendi içinde: 6. 6 haneli OTP üret; yalnız özet saklanır (300 sn, 5 deneme). SMS YOK&lt;br&gt;7. [Spring IdP] -&gt; [seal-mobile]: 7. demoOtp (lab: konsol ekranda gösterir)&lt;br&gt;8. [seal-mobile] -&gt; [Mobil uygulama]: 8. NEW_DEVICE + demoOtp&lt;br&gt;9. [Mobil uygulama] -&gt; [seal-mobile]: 9. POST /seal/mobile/v1/device/otp  {flowId, otp}&lt;br&gt;10. [seal-mobile] -&gt; [kgateway gw-internal]: 10. POST /internal/auth/otp/verify  {username, flowId, code}&lt;br&gt;11. [Spring IdP] kendi içinde: 11. OTP doğrula → OK ise alice 'bekleyen aktivasyon' listesine girer&lt;br&gt;12. [Spring IdP] -&gt; [Mobil uygulama]: 12. OTP_OK, activationRequired=true&lt;br&gt;13. [Mobil uygulama] -&gt; [Spring IdP]: 13. yeni mobil token (PKCE + DPoP)&lt;br&gt;14. [Spring IdP] kendi içinde: 14. KISITLI TOKEN: restricted=true, scope=activation&lt;br&gt;15. [Spring IdP] -&gt; [Mobil uygulama]: 15. kısıtlı access_token&lt;br&gt;16. [Mobil uygulama] -&gt; [ext-authz]: 16. GET /bff/mobile/accounts  (kısıtlı token)&lt;br&gt;17. [ext-authz] kendi içinde: 17. restricted → 403 (iş API'sine girmez)&lt;br&gt;18. [ext-authz] -&gt; [Mobil uygulama]: 18. 403 kısıtlı oturum: aktivasyon gerekli&lt;br&gt;19. [Mobil uygulama] -&gt; [seal-mobile]: 19. POST /seal/mobile/v1/activation/start  (kısıtlı token, passthrough)&lt;br&gt;20. [seal-mobile] -&gt; [kgateway gw-internal]: 20. POST /internal/auth/activation/token  {username}&lt;br&gt;21. [Spring IdP] -&gt; [seal-intranet]: 21. create-activation-token  (seal-b2b JWT)&lt;br&gt;22. [seal-intranet] -&gt; [Spring IdP]: 22. activationToken&lt;br&gt;23. [Spring IdP] -&gt; [Mobil uygulama]: 23. activationToken (IdP'de device_activation: PENDING)&lt;br&gt;24. [Mobil uygulama] -&gt; [seal-mobile]: 24. POST /device/enroll  {pin}  (yeni cihaz PIN kaydı)&lt;br&gt;25. [seal-mobile] -&gt; [kgateway gw-internal]: 25. PM pin/set (gw-internal)&lt;br&gt;26. [Mobil uygulama] -&gt; [seal-mobile]: 26. POST /activation/complete  {activationToken}&lt;br&gt;27. [seal-mobile] -&gt; [kgateway gw-internal]: 27. POST /internal/auth/activation/complete&lt;br&gt;28. [Spring IdP] kendi içinde: 28. device_activation: ACTIVATED; bekleyen aktivasyon listesinden çıkar&lt;br&gt;29. [Spring IdP] -&gt; [Mobil uygulama]: 29. ACTIVATED  (sonraki token'lar kısıtsız)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="1080" height="490" as="geometry"/></mxCell>
        <mxCell id="p7_c100" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2084" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
