        <mxCell id="p5_c58" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="773" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c59" value="15. /internal/auth/* (HTTPS, istemci CN=gw-internal)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c57" target="p5_c58"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c60" value="16. auth_flow kaydı: flowId → alice, PIN_AUTHORIZED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="501" y="806" width="180" height="30" as="geometry"/></mxCell>
