        <mxCell id="p5_c49" value="11. cihaz anahtarıyla nonce'u imzala (RS256 / PKCS1v15)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="121" y="576" width="180" height="30" as="geometry"/></mxCell>
