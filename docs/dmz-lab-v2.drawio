        <mxCell id="p5_c31" value="2. L4 passthrough (TLS açılmaz)" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="311" y="2678" width="178" height="16" as="geometry"/></mxCell>
