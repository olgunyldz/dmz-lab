        <mxCell id="p6_c61" value="15. forwardToken: iç JWT" style="endArrow=classic;html=1;strokeColor=#B91C1C;strokeWidth=2.6;fontSize=10;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p6_c59" target="p6_c60"><mxGeometry relative="1" as="geometry"/></mxCell>
