        <mxCell id="p9_c70" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="911" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c71" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="911" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c72" value="18. 200" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p9_c70" target="p9_c71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9_c73" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="957" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c74" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="957" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c75" value="19. 200" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p9_c73" target="p9_c74"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9_c76" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="1003" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c77" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="1003" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p9_c78" value="20. 200" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p9_c76" target="p9_c77"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p9_c79" value="KONTROLLER: K1 dış token yalnız DMZ'de; iç token istemciye dönmez. K2 oturum iptali exchange'de. K3 iç gateway RBAC (x-channel). K4 kısıtlı token ext-authz'da engellenir.&lt;br&gt;LAB → PROD: aynı şablon mobil ile; kanal profilleri (ChannelClaims) prod'da tek politika motorunda." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1074" width="1460" height="76" as="geometry"/></mxCell>
        <mxCell id="p9_c80" value="Adım legend'ı&lt;br&gt;1. [Tarayıcı] -&gt; [HAProxy]: 1. GET /bff/web/accounts  Authorization: Bearer &lt;web token&gt;&lt;br&gt;2. [HAProxy] -&gt; [kgateway gw-web]: 2. TLS re-encrypt (NodePort 30446)&lt;br&gt;3. [kgateway gw-web] -&gt; [ext-authz]: 3. ext-authz: X-Dmz-Channel=web, Authorization&lt;br&gt;4. [ext-authz] kendi içinde: 4. RS256 (JWKS), iss, aud=channel-web, channel=web, exp&lt;br&gt;5. [ext-authz] kendi içinde: 5. KISIT: restricted / scope=activation → 403&lt;br&gt;6. [ext-authz] -&gt; [kgateway gw-internal]: 6. token exchange (mTLS CN=dmz-exchange-web), subject = web token&lt;br&gt;7. [kgateway gw-internal] -&gt; [Spring IdP]: 7. /token grant=token-exchange  audience=kgateway-internal&lt;br&gt;8. [Spring IdP] kendi içinde: 8. subject imzası + OTURUM AKTİF mi (kayıt yoksa invalid_grant)&lt;br&gt;9. [Spring IdP] kendi içinde: 9. iç JWT: aud=kgateway-internal, channel=web&lt;br&gt;10. [Spring IdP] -&gt; [kgateway gw-internal]: 10. iç JWT&lt;br&gt;11. [kgateway gw-internal] -&gt; [ext-authz]: 11. iç JWT&lt;br&gt;12. [ext-authz] -&gt; [kgateway gw-web]: 12. 200 + Authorization: Bearer &lt;iç JWT&gt;&lt;br&gt;13. [kgateway gw-web] -&gt; [kgateway gw-internal]: 13. GET /bff/web/accounts + iç JWT (mTLS DMZ)&lt;br&gt;14. [kgateway gw-internal] -&gt; [BFF app-bff]: 14. RBAC x-channel=web; forwardToken&lt;br&gt;15. [BFF app-bff] -&gt; [core app-core]: 15. hesap sorgusu (iç JWT)&lt;br&gt;16. [core app-core] -&gt; [BFF app-bff]: 16. hesaplar&lt;br&gt;17. [BFF app-bff] -&gt; [kgateway gw-internal]: 17. 200  channel=web  (token yok)&lt;br&gt;18. [kgateway gw-internal] -&gt; [kgateway gw-web]: 18. 200&lt;br&gt;19. [kgateway gw-web] -&gt; [HAProxy]: 19. 200&lt;br&gt;20. [HAProxy] -&gt; [Tarayıcı]: 20. 200" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1166" width="1460" height="346" as="geometry"/></mxCell>
        <mxCell id="p9_c81" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1526" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
