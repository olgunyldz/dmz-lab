        <mxCell id="p4_c28" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="175" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c29" value="2. L4 passthrough (TLS açılmaz)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c27" target="p4_c28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c30" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="221" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c31" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="221" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c32" value="3. TLS passthrough → seal-mobile" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c30" target="p4_c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c33" value="4. cihaz CN: CERT_REQUIRED (device CA)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="691" y="254" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p4_c34" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c35" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="313" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c36" value="5. POST /seal/mobile/v1/device/enroll  {pin}  Authorization: Bearer &lt;IdP token&gt;  DPoP" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c34" target="p4_c35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c37" value="6. token: JWKS (HTTPS) imza, iss, aud=channel-mobile, channel=mobile, cnf" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="691" y="346" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p4_c38" value="7. DPoP: imza(jwk), htm, htu, iat, ath, jkt=cnf.jkt, jti (replay)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="691" y="392" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p4_c39" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c40" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="451" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c41" value="8. POST /token/introspect  (istemci seal-mobile)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c39" target="p4_c40"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c42" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c43" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="497" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c44" value="9. active=true, sub=alice" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c42" target="p4_c43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c45" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="543" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c46" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="543" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c47" value="10. POST /seal-pm/v1/pin/set  (DMZ istemci mTLS, X-Seal-Key)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c45" target="p4_c46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c48" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c49" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1254" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c50" value="11. /seal-pm/ BackendTLSPolicy (HTTPS)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c48" target="p4_c49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c51" value="12. scrypt(PIN taşıma hash) → (alice, cihaz CN) doğrulayıcı" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="1261" y="622" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="p4_c52" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1254" y="681" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c53" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="681" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p4_c54" value="13. 200  ENROLLED" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c52" target="p4_c53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4_c55" value="KONTROLLER: K1 seal-mobile TLS'i sonlandırır; gateway görmez. K2 IdP token ve DPoP birlikte doğrulanır; oturum introspection ile aktif. K3 PM yalnız PIN doğrulayıcı tutar.&lt;br&gt;LAB → PROD: PIN taşıma hash'i (sha256) vendor'ın KPu/JWE akışı değil. Cihaz kaydı (enrollment) ve attestation yok; sertifika lab CA'sı." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="1270" height="76" as="geometry"/></mxCell>
        <mxCell id="p4_c56" value="Adım legend'ı&lt;br&gt;1. [Mobil uygulama] -&gt; [HAProxy]: 1. TLS SNI seal.lab.local  istemci sertifikası (cihaz CA)&lt;br&gt;2. [HAProxy] -&gt; [kgateway gw-seal]: 2. L4 passthrough (TLS açılmaz)&lt;br&gt;3. [kgateway gw-seal] -&gt; [seal-mobile]: 3. TLS passthrough → seal-mobile&lt;br&gt;4. [seal-mobile] kendi içinde: 4. cihaz CN: CERT_REQUIRED (device CA)&lt;br&gt;5. [Mobil uygulama] -&gt; [seal-mobile]: 5. POST /seal/mobile/v1/device/enroll  {pin}  Authorization: Bearer &lt;IdP token&gt;  DPoP&lt;br&gt;6. [seal-mobile] kendi içinde: 6. token: JWKS (HTTPS) imza, iss, aud=channel-mobile, channel=mobile, cnf&lt;br&gt;7. [seal-mobile] kendi içinde: 7. DPoP: imza(jwk), htm, htu, iat, ath, jkt=cnf.jkt, jti (replay)&lt;br&gt;8. [seal-mobile] -&gt; [Spring IdP]: 8. POST /token/introspect  (istemci seal-mobile)&lt;br&gt;9. [Spring IdP] -&gt; [seal-mobile]: 9. active=true, sub=alice&lt;br&gt;10. [seal-mobile] -&gt; [kgateway gw-internal]: 10. POST /seal-pm/v1/pin/set  (DMZ istemci mTLS, X-Seal-Key)&lt;br&gt;11. [kgateway gw-internal] -&gt; [password-manager]: 11. /seal-pm/ BackendTLSPolicy (HTTPS)&lt;br&gt;12. [password-manager] kendi içinde: 12. scrypt(PIN taşıma hash) → (alice, cihaz CN) doğrulayıcı&lt;br&gt;13. [password-manager] -&gt; [Mobil uygulama]: 13. 200  ENROLLED" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="844" width="1270" height="234" as="geometry"/></mxCell>
        <mxCell id="p4_c57" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1092" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
