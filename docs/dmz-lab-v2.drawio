        <mxCell id="p4_c26" value="1. TLS SNI seal.lab.local  istemci sertifikası (cihaz CA)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p4_c24" target="p4_c25"><mxGeometry relative="1" as="geometry"/></mxCell>
