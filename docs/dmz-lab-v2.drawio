        <mxCell id="p12_c101" value="26. oturum kısıtını kaldır" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="691" y="1510" width="180" height="30" as="geometry"/></mxCell>
