        <mxCell id="p9_c6" value="Mobil uygulama&lt;br&gt;(Seal SDK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="8892" width="170" height="64" as="geometry"/></mxCell>
