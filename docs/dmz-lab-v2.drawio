        <mxCell id="p12_c95" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="1431" width="2" height="2" as="geometry"/></mxCell>
