        <mxCell id="p8_c35" value="6. GET /login  →  form (_csrf)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p8_c33" target="p8_c34"><mxGeometry relative="1" as="geometry"/></mxCell>
