        <mxCell id="p5_c20" value="" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#94A3B8;strokeWidth=1.1;edgeStyle=none;" edge="1" parent="1" source="p5_c18" target="p5_c19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c21" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="129" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c22" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="129" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c23" value="1. POST /login/begin  Bearer &lt;IdP token&gt; + DPoP  (passthrough, cihaz mTLS)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c21" target="p5_c22"><mxGeometry relative="1" as="geometry"/></mxCell>
