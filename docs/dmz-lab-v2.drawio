        <mxCell id="p13_c64" value="12. onPinAcquired(pin)" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p13_c62" target="p13_c63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p13_c65" value="NEW_PIN_Hash = sha256(pin.new)&lt;br&gt;NEW_PIN_ENC_Transport = encrypt(KPu_PIN, NEW_PIN_Hash)" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=10;align=left;spacing=4;" vertex="1" parent="1"><mxGeometry x="365" y="732" width="260" height="44" as="geometry"/></mxCell>
