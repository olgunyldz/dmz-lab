        <mxCell id="p12_c36" value="3. KPu_PIN" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p12_c34" target="p12_c35"><mxGeometry relative="1" as="geometry"/></mxCell>
