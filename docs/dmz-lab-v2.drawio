        <mxCell id="p5_c55" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="727" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c56" value="14. POST /internal/auth/flow/update  {PIN_AUTHORIZED}  (DMZ mTLS)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c54" target="p5_c55"><mxGeometry relative="1" as="geometry"/></mxCell>
