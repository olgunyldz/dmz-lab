        <mxCell id="p2_c91" value="Ok açıklamaları" style="text;html=1;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="p2_c92" value="1. HTTPS :443 (web.lab.local)&lt;br&gt;2. HTTPS (mobile-api.lab.local)&lt;br&gt;3. SNI seal (cihaz mTLS)&lt;br&gt;4. SNI partner-api&lt;br&gt;5. WAN · cihaz mTLS (F10)&lt;br&gt;6. yeniden şifreleme · mTLS&lt;br&gt;7. yeniden şifreleme · mTLS&lt;br&gt;8. L4 TCP&lt;br&gt;9. L4 passthrough&lt;br&gt;10. ext-authz&lt;br&gt;11. ext-authz&lt;br&gt;12. ext-authz (branch)&lt;br&gt;13. token exchange (HTTPS, XFCC ile istemci sertifikası)" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1022" width="900" height="192" as="geometry"/></mxCell>
        <mxCell id="p2_c93" value="14. mTLS (BackendTLSPolicy)&lt;br&gt;15. mTLS (BackendTLSPolicy)&lt;br&gt;16. mTLS&lt;br&gt;17. TLS passthrough (cihaz mTLS)&lt;br&gt;18. /internal/auth · /seal-pm (DMZ mTLS)&lt;br&gt;19. HTTPS (iç CA)&lt;br&gt;20. HTTPS (iç CA)&lt;br&gt;21. /internal/auth (HTTPS, CN=gw-internal)&lt;br&gt;22. /seal-pm (HTTPS)&lt;br&gt;23. timestamp · aktivasyon token'ı (HTTPS, seal-b2b JWT)&lt;br&gt;24. JWKS (HTTPS, küme içi)&lt;br&gt;25. JDBC" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="960" y="1022" width="900" height="178" as="geometry"/></mxCell>
