        <mxCell id="p8_c42" value="9. 302 → auth (devam) → callback?code=..." style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p8_c40" target="p8_c41"><mxGeometry relative="1" as="geometry"/></mxCell>
