        <mxCell id="p8_c38" value="7. POST /login  username=alice  parola (YALNIZ IdP'de)  _csrf" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p8_c36" target="p8_c37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p8_c39" value="8. parola BCrypt doğrula (JdbcUserDetailsManager)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;align=left;" vertex="1" parent="1"><mxGeometry x="881" y="438" width="180" height="30" as="geometry"/></mxCell>
