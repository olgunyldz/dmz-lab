        <mxCell id="p5_c62" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="865" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c63" value="17. PIN_AUTHORIZED" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c61" target="p5_c62"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c64" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="911" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c65" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="911" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c66" value="18. login-status (PLANLI: app-bff üzerinden) → /internal/auth/login/status" style="endArrow=classic;html=1;dashed=1;dashPattern=6 4;strokeColor=#9CA3AF;strokeWidth=1.3;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c64" target="p5_c65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c67" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="957" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c68" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="957" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c69" value="19. create-timestamp  (seal-b2b JWT, aud=seal-intranet)" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=1.4;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c67" target="p5_c68"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c70" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="1003" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c71" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="1003" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c72" value="20. timestamp" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c70" target="p5_c71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c73" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="1049" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c74" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="1049" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p5_c75" value="21. status=PIN_AUTHORIZED, restricted=false, timestamp" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p5_c73" target="p5_c74"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c76" value="KONTROLLER: K1 her Seal çağrısında IdP token + DPoP + introspection. K2 PIN kilidi 5 denemede. K3 cihaz imzası tek kullanımlık ve cihaza bağlı.&lt;br&gt;LAB → PROD: login-status yolu (adım 18) henüz app-bff'e bağlı değil. Seal Intranet identity'de, yalnız IdP çağırır." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1080" height="76" as="geometry"/></mxCell>
        <mxCell id="p5_c77" value="Adım legend'ı&lt;br&gt;1. [Mobil uygulama] -&gt; [seal-mobile]: 1. POST /login/begin  Bearer &lt;IdP token&gt; + DPoP  (passthrough, cihaz mTLS)&lt;br&gt;2. [seal-mobile] -&gt; [Spring IdP]: 2. introspection (oturum aktif mi)&lt;br&gt;3. [Spring IdP] -&gt; [seal-mobile]: 3. active=true, sub=alice&lt;br&gt;4. [seal-mobile] -&gt; [Mobil uygulama]: 4. flowId&lt;br&gt;5. [Mobil uygulama] -&gt; [seal-mobile]: 5. POST /login/pin  {flowId, pin}&lt;br&gt;6. [seal-mobile] -&gt; [kgateway gw-internal]: 6. POST /seal-pm/v1/pin/verify  (DMZ mTLS, X-Seal-Key)&lt;br&gt;7. [kgateway gw-internal] -&gt; [password-manager]: 7. /seal-pm/ (BackendTLSPolicy, HTTPS)&lt;br&gt;8. [password-manager] kendi içinde: 8. scrypt doğrula; 5 yanlış → kilit; kayıtlı değilse enrolled=false&lt;br&gt;9. [password-manager] -&gt; [seal-mobile]: 9. ok, enrolled, expired, locked&lt;br&gt;10. [seal-mobile] -&gt; [Mobil uygulama]: 10. PIN_OK + authorizationId + nonce (60 sn, tek kullanım)&lt;br&gt;11. [Mobil uygulama] kendi içinde: 11. cihaz anahtarıyla nonce'u imzala (RS256 / PKCS1v15)&lt;br&gt;12. [Mobil uygulama] -&gt; [seal-mobile]: 12. POST /login/authorize  {authorizationId, signature}&lt;br&gt;13. [seal-mobile] kendi içinde: 13. cihaz sertifikasının açık anahtarıyla imza doğrula (tek kullanım)&lt;br&gt;14. [seal-mobile] -&gt; [kgateway gw-internal]: 14. POST /internal/auth/flow/update  {PIN_AUTHORIZED}  (DMZ mTLS)&lt;br&gt;15. [kgateway gw-internal] -&gt; [Spring IdP]: 15. /internal/auth/* (HTTPS, istemci CN=gw-internal)&lt;br&gt;16. [Spring IdP] kendi içinde: 16. auth_flow kaydı: flowId → alice, PIN_AUTHORIZED&lt;br&gt;17. [seal-mobile] -&gt; [Mobil uygulama]: 17. PIN_AUTHORIZED&lt;br&gt;18. [Mobil uygulama] -&gt; [Spring IdP]: 18. login-status (PLANLI: app-bff üzerinden) → /internal/auth/login/status&lt;br&gt;19. [Spring IdP] -&gt; [seal-intranet]: 19. create-timestamp  (seal-b2b JWT, aud=seal-intranet)&lt;br&gt;20. [seal-intranet] -&gt; [Spring IdP]: 20. timestamp&lt;br&gt;21. [Spring IdP] -&gt; [Mobil uygulama]: 21. status=PIN_AUTHORIZED, restricted=false, timestamp" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1212" width="1080" height="362" as="geometry"/></mxCell>
        <mxCell id="p5_c78" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1588" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
