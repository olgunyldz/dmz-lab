          <mxCell id="n186" value="1. vault status (hazır olana kadar bekle)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="130" as="sourcePoint"/><mxPoint x="305" y="130" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n187" value="2. vault operator init (key-shares=1, threshold=1)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="176" as="sourcePoint"/><mxPoint x="305" y="176" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n188" value="3. unseal anahtarı + root token → secret" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="222" as="sourcePoint"/><mxPoint x="495" y="222" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n189" value="4. vault operator unseal" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="268" as="sourcePoint"/><mxPoint x="305" y="268" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n190" value="5. KV v2 (secret/), politika keycloak (read)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="314" as="sourcePoint"/><mxPoint x="305" y="314" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n191" value="6. secret/identity/keycloak: db_password, admin_password (yoksa üret)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="360" as="sourcePoint"/><mxPoint x="305" y="360" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n192" value="7. kv get db_password, admin_password" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="416" as="sourcePoint"/><mxPoint x="305" y="416" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n193" value="8. create secret keycloak-db, keycloak-admin (ns auth)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="462" as="sourcePoint"/><mxPoint x="685" y="462" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n194" value="9. Keycloak ve PostgreSQL bu secret'lardan okur" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="508" as="sourcePoint"/><mxPoint x="875" y="508" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n195" value="KONTROLLER: K1 Vault yalnız mgmt cluster'da; erişim F9 host firewall ile identity ve internal node'larına kısıtlı. K2 parolalar Git'e girmez, rastgele üretilir.&lt;br&gt;K3 Keycloak politikası yalnız okuma yetkisi taşır. K4 bootstrap secret yalnız mgmt ns secrets içinde.&lt;br&gt;LAB → PROD: lab emptyDir, Vault yeniden başlarsa yeniden init. Prod: Raft storage, auto-unseal (KMS/HSM), kısa ömürlü token, ESO ile identity'ye senkron, bootstrap secret kaldırılır." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="890" height="106" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
