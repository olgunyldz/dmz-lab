          <mxCell id="n160" value="13. OTP / push doğrulama" style="endArrow=classic;html=1;strokeColor=#333333;dashed=1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="692" as="sourcePoint"/><mxPoint x="1065" y="692" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n161" value="14. MFA onayı (acr=2)" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;dashed=1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="738" as="sourcePoint"/><mxPoint x="875" y="738" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n162" value="15. 302 Location: redirect_uri?code=&lt;kod&gt;" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="784" as="sourcePoint"/><mxPoint x="685" y="784" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n163" value="16. 302" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="830" as="sourcePoint"/><mxPoint x="495" y="830" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n164" value="17. 302" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="876" as="sourcePoint"/><mxPoint x="305" y="876" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n165" value="18. 302 → redirect_uri" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="922" as="sourcePoint"/><mxPoint x="115" y="922" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n166" value="19. POST /realms/.../token  code + code_verifier (PKCE)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="978" as="sourcePoint"/><mxPoint x="305" y="978" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n167" value="20. re-encrypt" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1024" as="sourcePoint"/><mxPoint x="495" y="1024" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n168" value="21. /realms/* (mTLS, F2)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1070" as="sourcePoint"/><mxPoint x="685" y="1070" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n169" value="22. code + code_verifier doğrula (S256)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="1116" as="sourcePoint"/><mxPoint x="875" y="1116" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n170" value="23. dış access token + refresh token" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="1162" as="sourcePoint"/><mxPoint x="685" y="1162" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n171" value="24. 200" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="1208" as="sourcePoint"/><mxPoint x="495" y="1208" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n172" value="25. 200" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="1254" as="sourcePoint"/><mxPoint x="305" y="1254" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n173" value="26. 200 token yanıtı" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1300" as="sourcePoint"/><mxPoint x="115" y="1300" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n174" value="KONTROLLER: K1 Authorization Code + PKCE (S256). K2 redirect_uri tam eşleşme. K3 login trafiği ext-authz'den geçmez, kimlik yolu DMZ→iç mTLS ile korunur.&lt;br&gt;K4 MFA (acr=2) zorunluluğu planlı. K5 iç token bu akışta üretilmez; yalnız API çağrısında exchange ile üretilir.&lt;br&gt;LAB → PROD: hedef web için BFF oturum deseni (token sunucuda, tarayıcıda HttpOnly çerez, D-10). redirect_uri sıkı; brute-force koruması; MFA zorunlu." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="1080" height="106" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
