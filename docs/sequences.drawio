          <mxCell id="n158" value="11. /realms/* (mTLS, F2)" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="600" as="sourcePoint"/><mxPoint x="685" y="600" as="targetPoint"/></mxGeometry></mxCell>
