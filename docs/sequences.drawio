          <mxCell id="n33" value="17. 200" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="866" as="sourcePoint"/><mxPoint x="305" y="866" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n34" value="18. 200" style="endArrow=classic;html=1;dashed=1;strokeColor=#888888;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="912" as="sourcePoint"/><mxPoint x="115" y="912" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="n35" value="KONTROLLER: K1 dış token yalnız DMZ'de doğrulanır. K2 iç token yalnız DMZ→iç bağlantıda dolaşır, istemciye dönmez.&lt;br&gt;K3 DMZ→iç mTLS, XFCC iç gateway'de temizlenir. K4 iç gateway RBAC (x-channel). K5 BFF iç JWT'yi kendisi de doğrular (savunma derinliği).&lt;br&gt;LAB → PROD: WAF/DDoS ve HA prod'da F5 veya CDN ve çift LB. Sertifikalar Vault PKI. İmzalama anahtarları HSM/KMS (D-12). Web için BFF oturum deseni (D-10)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="1270" height="106" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
