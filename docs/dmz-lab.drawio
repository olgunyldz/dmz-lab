        <mxCell id="p13_c45" value="" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p13_c43" target="p13_c44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p13_c46" value="8. 200" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="311" y="524" width="178" height="16" as="geometry"/></mxCell>
        <mxCell id="p13_c47" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p13_c48" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="589" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p13_c49" value="" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p13_c47" target="p13_c48"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p13_c50" value="9. 200" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="121" y="570" width="178" height="16" as="geometry"/></mxCell>
        <mxCell id="p13_c51" value="KONTROLLER: K1 yalnız GET ve tanımlı yollar (default deny). POST /public/* 404. K2 WAF ve IP başına L7 rate limit. K3 public yol yalnız core'da açık, BFF açmaz (/bff/* token'sız 401).&lt;br&gt;K4 public route ext-authz'i atlar, bu yüzden iç token üretilmez ve dış token iç ağa girmez. K5 public yol listesi config ile sınırlı.&lt;br&gt;LAB → PROD: public yol kataloğu onaylı liste; bot koruması ve önbellekleme (CDN); yanıt boyutu ve zaman aşımı limitleri." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="890" height="106" as="geometry"/></mxCell>
        <mxCell id="p13_c52" value="Adım legend'ı&lt;br&gt;1. GET /public/branches | [Kullanıcı] -&gt; [HAProxy]: 1. GET /public/branches (token yok)&lt;br&gt;2. 2. WAF + L7 rate limit | [HAProxy] -&gt; [kgateway gw-web]: 2. WAF + L7 rate limit (IP başına), TLS re-encrypt&lt;br&gt;3. 3. public-web route | [kgateway gw-web] -&gt; [kgateway internal]: 3. public-web route: ext-authz YOK, yalnız GET&lt;br&gt;4. 4. /public/* route | [kgateway internal] -&gt; [Core app-core]: 4. /public/* route (JWT yok; default deny dışında açık)&lt;br&gt;5. 5. PUBLIC_PATHS=1 | [Core app-core] kendi içinde: 5. PUBLIC_PATHS=1: token olmadan kabul&lt;br&gt;6. 6. 200  service=core path=/public/branches | [Core app-core] -&gt; [kgateway internal]: 6. 200  service=core path=/public/branches&lt;br&gt;7. 7. 200 | [kgateway internal] -&gt; [kgateway gw-web]: 7. 200&lt;br&gt;8. 8. 200 | [kgateway gw-web] -&gt; [HAProxy]: 8. 200&lt;br&gt;9. 9. 200 | [HAProxy] -&gt; [Kullanıcı]: 9. 200" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="1000" height="170" as="geometry"/></mxCell>
        <mxCell id="p13_c53" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p14" name="5 Web login (Authorization Code + PKCE)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1190" pageHeight="2082" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p14_c2" value="5) Web giriş: Authorization Code + PKCE, MFA hedefi (design 4.4, 5.1-A)" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="p14_c3" value="Kullanıcı&lt;br&gt;(tarayıcı)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;fontStyle=1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="170" height="64" as="geometry"/></mxCell>
