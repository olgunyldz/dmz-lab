        <mxCell id="p8_c38" value="yeni cihaz OTP" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="752" y="319" width="86" height="18" as="geometry"/></mxCell>
        <mxCell id="p8_c39" value="Akış: 1) splash (/janus/splash)  2) PKCE ile token (auth-server)  3) Seal: login/pin (PIN monolitte), login/authorize (cihaz imzası)  4) secure-login ve mobile-login  5) client token. Yeni cihazda SMS kodu /sms sayfasından alınır, aktivasyon sonrası aynı akış tekrarlanır." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="Lab · Sırlar ve veri">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p9_c2" value="Lab · sırlar, sertifikalar ve veri" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1800" height="36" as="geometry"/></mxCell>
        <mxCell id="p9_c3" value="Repoda sır yoktur. Sırlar Vault'ta ve Kubernetes secret'larında; sertifikalar iç CA ile üretilir (edge/certs, gitignore)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1800" height="24" as="geometry"/></mxCell>
        <mxCell id="p9_c4" value="&lt;table style=&quot;border-collapse:collapse;font-size:12.5px;font-family:Segoe UI;color:#1f1f1f&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Kaynak&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Yer&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;İçerik&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Üreten / kullanan&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Vault KV v2 secret/auth/auth-server&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-prod · ns secrets&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;IdP sırları (AUTH_* anahtarları, SEAL_B2B_SECRET, SEAL_MOBILE_SECRET)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;auth hook, up.sh / auth-server&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Vault KV v2 secret/seal/v3&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-prod · ns secrets&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;SEAL_PM_KEY, SEAL_MOCK_KEY&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;scripts/seal-keys.sh / seal-mobile, monolit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;auth-secrets, auth-tls, auth-signing&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-prod · ns auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;k8s secret: sırlar, TLS keystore/truststore, imzalama anahtarı&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/auth-server/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;janus-keys, janus-mtls-web/-mobile&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-dmz-prod · ns janus&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Janus server anahtarları (JANUS_KEY_*), istemci mTLS&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/janus/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;channel-gateway-tls/-client, janus-verify&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-prod · ns channel&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;mTLS sertifikaları, Janus doğrulama anahtarları&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/channel-gateway/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;fortuna-*-tls, fortuna-*-client, fortuna-db, fortuna-seed&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;bank-prod · ns channel&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Fortuna zinciri mTLS, DB parolası (.env), seed parolası&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/fortuna/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;sm-tls, sm-device-ca, sm-internal-ca, sm-auth-client, sm-keys&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;codevo-dmz · ns seal-mobile&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Seal Mobile sunucu, cihaz CA, istemci sertifikası, paylaşılan anahtarlar&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/seal-mobile/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;seal-intranet-tls, si-mock, internal-ca-backend&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;codevo-dmz · ns seal-intranet&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;Seal Intranet sunucu sertifikası, mock anahtar, iç CA&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;apps/seal-intranet/hook.sh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;platform/.env&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;host&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;LEGACYDB_PASSWORD, GRAFANA_ADMIN_PASSWORD, PM_KEY, SEAL_B2B_SECRET, düğüm IP'leri&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;platform/scripts/up.sh (gitignore)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;LegacyDB (lab: PostgreSQL 16 · as-is: MSSQL)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;platform&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;customers, accounts, fortuna_users, customer_devices, pin_verifiers, transactions&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px;vertical-align:top&quot;&gt;monolit (services/legacy-monolith)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1820" height="640" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p7" name="As-is: batıdan doğuya">
