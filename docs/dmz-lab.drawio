        <mxCell id="p15_c51" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="874" y="599" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p15_c52" value="" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p15_c50" target="p15_c51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15_c53" value="9. IdP ve PostgreSQL bu secret'lardan okur" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="691" y="568" width="178" height="28" as="geometry"/></mxCell>
        <mxCell id="p15_c54" value="KONTROLLER: K1 Vault yalnız mgmt cluster'da; erişim F9 host firewall ile identity ve internal node'larına kısıtlı. K2 parolalar Git'e girmez, rastgele üretilir.&lt;br&gt;K3 Vault politikası yalnız okuma yetkisi taşır. K4 bootstrap secret yalnız mgmt ns secrets içinde.&lt;br&gt;LAB → PROD: lab emptyDir, Vault yeniden başlarsa yeniden init. Prod: Raft storage, auto-unseal (KMS/HSM), kısa ömürlü token, ESO ile identity'ye senkron, bootstrap secret kaldırılır." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="890" height="106" as="geometry"/></mxCell>
        <mxCell id="p15_c55" value="Adım legend'ı&lt;br&gt;1. 1. vault status | [Operatör] -&gt; [Vault 1.18]: 1. vault status (hazır olana kadar bekle)&lt;br&gt;2. 2. vault operator init | [Operatör] -&gt; [Vault 1.18]: 2. vault operator init (key-shares=1, threshold=1)&lt;br&gt;3. 3. unseal anahtarı + root token → secret | [Vault 1.18] -&gt; [vault-bootstrap]: 3. unseal anahtarı + root token → secret&lt;br&gt;4. 4. vault operator unseal | [Operatör] -&gt; [Vault 1.18]: 4. vault operator unseal&lt;br&gt;5. 5. KV v2 | [Operatör] -&gt; [Vault 1.18]: 5. KV v2 (secret/) hazır&lt;br&gt;6. 6. IdP sırları | [Operatör] -&gt; [Vault 1.18]: 6. IdP sırları (üretilir, repoya yazılmaz)&lt;br&gt;7. 8. create secret idp-secrets, idp-tls | [Operatör] -&gt; [Identity API]: 8. create secret idp-secrets, idp-tls (ns idp)&lt;br&gt;8. 9. IdP ve PostgreSQL bu secret'lardan okur | [Identity API] -&gt; [IdP secret'ları]: 9. IdP ve PostgreSQL bu secret'lardan okur" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1000" height="154" as="geometry"/></mxCell>
        <mxCell id="p15_c56" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
