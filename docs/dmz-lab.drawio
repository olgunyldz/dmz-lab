    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="630" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p6_c2" value="Lab · ingress kuralları ve giriş yolları" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1800" height="36" as="geometry"/></mxCell>
        <mxCell id="p6_c3" value="Edge (HAProxy, 127.0.0.1:8443) hostname'e göre yönlendirir; cluster ingress'leri host ve SNI'a göre dağıtır." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1800" height="24" as="geometry"/></mxCell>
        <mxCell id="p6_c4" value="&lt;table style=&quot;border-collapse:collapse;font-size:13px;font-family:Segoe UI;color:#1f1f1f&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Host / SNI&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Cluster&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Ingress&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Namespace&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Backend&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Mod&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:6px 10px;background:#F1F5F9;text-align:left&quot;&gt;Giriş (edge → NodePort)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;web.lab.local&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;bank-dmz-prod&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus-web&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus-web:8080&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;TLS edge'de sonlanır (HTTP ingress)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;edge → 30802&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;mobile-api.lab.local&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;bank-dmz-prod&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus-mobile&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;janus-mobile:8080&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;TLS edge'de sonlanır (HTTP ingress)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;edge → 30802&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal.lab.local&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;codevo-dmz&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-mobile&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-mobile&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-mobile:8443&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;SNI passthrough (cihaz mTLS pod'da)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;edge → 30456&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-intranet.lab.local&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;codevo-dmz&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-intranet&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-intranet&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;seal-intranet:8443&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;SNI passthrough&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;bridge-si → 30456&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;id.bank.lab.local&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;bank-prod&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;auth-server&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;auth&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;auth-server:8443&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;SNI passthrough&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:6px 10px&quot;&gt;bridge-auth / Seal → 30543&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1820" height="260" as="geometry"/></mxCell>
        <mxCell id="p6_c5" value="NodePort'lar (kind extraPortMappings ile host'a yalnız 30802 ve 30456 açıktır; diğerleri kind ağı üzerinden erişilir):&lt;br&gt;30081 / 30543 bank-prod ingress (30543: auth, passthrough) · 30880 / 30881 / 30990 channel NodePort'ları (Janus → bank-prod)&lt;br&gt;30802 / 30443 bank-dmz-prod ingress · 30080 / 30456 codevo-dmz ingress · 30644 Seal Intranet metrik NodePort (kullanılmıyor)&lt;br&gt;Ingress manifest'leri her uygulamanın klasöründedir: apps/&lt;ad&gt;/manifests/ingress.yaml." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1820" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
