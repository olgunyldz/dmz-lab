        <mxCell id="p12_c120" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="1579" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p12_c121" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="1579" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="p12_c122" value="" style="endArrow=open;html=1;dashed=1;dashPattern=5 4;strokeColor=#64748B;strokeWidth=1.2;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p12_c120" target="p12_c121"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p12_c123" value="28. 200" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="121" y="1560" width="178" height="16" as="geometry"/></mxCell>
        <mxCell id="p12_c124" value="KONTROLLER: K1 partner sertifikası TLS seviyesinde doğrulanır (gateway, ConfigMap partner-ca). K2 partner token'ı yalnız channel=partner ile geçerli.&lt;br&gt;K3 web token'ı /partner rotasında 403 döner (iç RBAC). K4 iç JWT servis tarafından da doğrulanır. K5 sertifikasız istek TLS el sıkışmasında reddedilir.&lt;br&gt;LAB → PROD: partner CA ve sertifikalar Vault PKI ile yönetilir. Partner başına client kaydı ve onay süreci. İptal kontrolü (CRL/OCSP) prod'da zorunlu." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="1270" height="106" as="geometry"/></mxCell>
        <mxCell id="p12_c125" value="Adım legend'ı&lt;br&gt;1. 1. mTLS 443, SNI partner-api.lab.local | [Partner] -&gt; [HAProxy]: 1. mTLS 443, SNI partner-api.lab.local (şifre çözülmez)&lt;br&gt;2. 2. TCP passthrough → NodePort 30448 | [HAProxy] -&gt; [kgateway gw-partner]: 2. TCP passthrough → NodePort 30448&lt;br&gt;3. 3. istemci sertifikası doğrula | [kgateway gw-partner] kendi içinde: 3. istemci sertifikası doğrula (partner CA)&lt;br&gt;4. 5. TCP passthrough | [HAProxy] -&gt; [kgateway gw-partner]: 5. TCP passthrough&lt;br&gt;5. 6. /realms/* → iç gateway | [kgateway gw-partner] -&gt; [kgateway internal]: 6. /realms/* → iç gateway (mTLS, F2)&lt;br&gt;6. 7. client credentials | [kgateway internal] -&gt; [IdP]: 7. client credentials (client-x509)&lt;br&gt;7. 8. partner dış token | [IdP] -&gt; [kgateway internal]: 8. partner dış token (channel=partner)&lt;br&gt;8. 9. 200 | [kgateway internal] -&gt; [kgateway gw-partner]: 9. 200&lt;br&gt;9. 10. 200 | [kgateway gw-partner] -&gt; [HAProxy]: 10. 200&lt;br&gt;10. 11. 200  dış token | [HAProxy] -&gt; [Partner]: 11. 200  dış token&lt;br&gt;11. 13. TCP passthrough | [HAProxy] -&gt; [kgateway gw-partner]: 13. TCP passthrough&lt;br&gt;12. 14. ext-authz | [kgateway gw-partner] -&gt; [ext-authz]: 14. ext-authz: X-Dmz-Channel=partner&lt;br&gt;13. 15. RS256 doğrula; channel=partner | [ext-authz] kendi içinde: 15. RS256 doğrula; channel=partner&lt;br&gt;14. 16. token exchange | [ext-authz] -&gt; [kgateway internal]: 16. token exchange (mTLS: CN=dmz-exchange-partner)&lt;br&gt;15. 17. /token grant=token-exchange | [kgateway internal] -&gt; [IdP]: 17. /token grant=token-exchange (XFCC)&lt;br&gt;16. 18. iç JWT | [IdP] -&gt; [kgateway internal]: 18. iç JWT (channel=partner)&lt;br&gt;17. 19. iç JWT | [kgateway internal] -&gt; [ext-authz]: 19. iç JWT&lt;br&gt;18. 20. 200 + Authorization | [ext-authz] -&gt; [kgateway gw-partner]: 20. 200 + Authorization: iç JWT&lt;br&gt;19. GET /partner/payments | [kgateway gw-partner] -&gt; [kgateway internal]: 21. GET /partner/payments + iç JWT (mTLS, F2)&lt;br&gt;20. 22. RBAC | [kgateway internal] kendi içinde: 22. RBAC: x-channel=partner&lt;br&gt;21. 23. forward | [kgateway internal] -&gt; [Core app-core]: 23. forward&lt;br&gt;22. 24. iç JWT doğrula; channel=partner kabul | [Core app-core] kendi içinde: 24. iç JWT doğrula; channel=partner kabul&lt;br&gt;23. 25. 200  service=core channel=partner | [Core app-core] -&gt; [kgateway internal]: 25. 200  service=core channel=partner&lt;br&gt;24. 26. 200 | [kgateway internal] -&gt; [kgateway gw-partner]: 26. 200&lt;br&gt;25. 27. 200 | [kgateway gw-partner] -&gt; [HAProxy]: 27. 200&lt;br&gt;26. 28. 200 | [HAProxy] -&gt; [Partner]: 28. 200" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1772" width="1270" height="442" as="geometry"/></mxCell>
        <mxCell id="p12_c126" value="&lt;span style='color:#334155'&gt;━━ istek&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#94A3B8'&gt;╍╍ yanıt&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#B91C1C'&gt;&lt;b&gt;━━ iç JWT (yalnız iç ağda)&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#9CA3AF'&gt;╍╍ planlı / prod&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2228" width="1000" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
