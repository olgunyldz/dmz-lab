        <mxCell id="p13_c29" value="3. public-web route: ext-authz YOK, yalnız GET" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="501" y="234" width="178" height="28" as="geometry"/></mxCell>
