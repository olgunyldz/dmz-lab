        <mxCell id="p5_c2" value="Şube cluster içi (kind-branch): WAN üzerinden doğrudan gw-branch, HAProxy yok" style="text;html=1;fontStyle=1;fontSize=18;align=left;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1300" height="34" as="geometry"/></mxCell>
        <mxCell id="p5_c3" value="Şube trafiği WAN üzerinden, F10 ile DMZ gw-branch'e (NodePort 30449) gider. Token exchange auth servisinde (ext-authz) yapılır." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1300" height="22" as="geometry"/></mxCell>
        <mxCell id="p5_c4" value="Şube cluster (kind-branch) · şube ağı" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#115E59;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="700" height="420" as="geometry"/></mxCell>
        <mxCell id="p5_c5" value="F10" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=1.5;fontStyle=1;fontSize=10;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="58" height="30" as="geometry"/></mxCell>
        <mxCell id="p5_c6" value="branch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.2;dashed=1;dashPattern=6 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontStyle=1;fontSize=11;fontColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="640" height="330" as="geometry"/></mxCell>
        <mxCell id="p5_c7" value="Şube UI pod (branch-ui)&lt;br&gt;port 9100 · host 9100 (NodePort 30900)&lt;br&gt;PKCE girişi (branch-app)&lt;br&gt;hesap sorgusu · güvenlik kontrolleri" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=1.3;fontSize=10;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="p5_c8" value="Secret branch-device-tls (cihaz sertifikası, internal-ca)&lt;br&gt;Secret branch-app-secrets (identity'den kopya)&lt;br&gt;ENV: BRANCH_GW_HOST = DMZ node IP, port 30449&lt;br&gt;HAProxy'den geçmez" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#A8A29E;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#57534E;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="p5_c9" value="Akış özeti:&lt;br&gt;1. Şube UI, gw-branch'e cihaz sertifikasıyla mTLS bağlanır&lt;br&gt;2. Login: /realms (PKCE, branch-app)&lt;br&gt;3. /bff/* istekleri ext-authz'e gider&lt;br&gt;4. ext-authz dış token'ı iç JWT'ye çevirir (exchange)&lt;br&gt;5. Iç JWT yalnız iç ağda dolaşır" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF9;strokeColor=#A8A29E;dashed=1;dashPattern=2 2;fontSize=9;fontColor=#57534E;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="290" height="270" as="geometry"/></mxCell>
        <mxCell id="p5_c10" value="gw-branch (kind-dmz)&lt;br&gt;mTLS cihaz doğrulama&lt;br&gt;/bff/*, /realms/*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.3;fontSize=10;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="p5_c11" value="ext-authz (auth, kind-dmz)&lt;br&gt;branch profili · token exchange" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.3;fontSize=10;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p5_c12" value="Keycloak (kind-identity)&lt;br&gt;branch-app PKCE · dmz-exchange-branch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.3;fontSize=10;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p5_c13" value="F10 · mTLS + /realms, /bff/*" style="endArrow=classic;html=1;rounded=1;strokeColor=#B91C1C;strokeWidth=2.6;fontSize=10;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p5_c7" target="p5_c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c14" value="ext-authz (branch)" style="endArrow=classic;html=1;rounded=1;strokeColor=#334155;strokeWidth=1.3;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p5_c10" target="p5_c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c15" value="token exchange (client-x509)" style="endArrow=open;html=1;rounded=1;strokeColor=#64748B;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p5_c11" target="p5_c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c16" value="/realms (login, PKCE)" style="endArrow=open;html=1;rounded=1;strokeColor=#64748B;strokeWidth=1.2;dashed=1;dashPattern=5 4;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p5_c10" target="p5_c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5_c17" value="&lt;b&gt;Notlar&lt;/b&gt;&lt;br&gt;• Şube kanalında HAProxy yok. gw-branch cihaz sertifikasını (branch-ca) doğrular; /partner ve /public 404 döner.&lt;br&gt;• Şube token'ı yalnız /bff için geçerli; iç RBAC x-channel == branch.&lt;br&gt;• Lab: şube UI branch cluster pod'u; teller.lab.local HAProxy'den çıkarıldı. Bağlantı kind ağı üzerinden gw-branch:30449 (WAN benzeri, F10)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="680" height="140" as="geometry"/></mxCell>
