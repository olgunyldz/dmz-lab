        <mxCell id="p4_c28" value="token exchange → iç JWT (mTLS)" style="endArrow=classic;html=1;rounded=1;strokeColor=#B91C1C;strokeWidth=2.6;fontSize=10;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p4_c18" target="p4_c20"><mxGeometry relative="1" as="geometry"/></mxCell>
