        <mxCell id="p15_c49" value="8. create secret idp-secrets, idp-tls (ns idp)" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="121" y="510" width="558" height="28" as="geometry"/></mxCell>
