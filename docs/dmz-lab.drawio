        <mxCell id="p10_c3" value="Aktif akışlar: web ve mobil. Diğer kanallar planlı. Kafka, RabbitMQ ve Redis rolleri varsayımdır, doğrulanacak." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1800" height="24" as="geometry"/></mxCell>
