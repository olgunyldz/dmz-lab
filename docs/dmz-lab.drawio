        <mxCell id="p4_c32" value="F10 · mTLS (cihaz sertifikası)" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="994" y="374" width="172" height="18" as="geometry"/></mxCell>
        <mxCell id="p4_c33" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#B91C1C;strokeWidth=2.6;fontSize=10;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p4_c18" target="p4_c20"><mxGeometry relative="1" as="geometry"/></mxCell>
