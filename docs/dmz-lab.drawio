        <mxCell id="p16_c70" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="1101" width="2" height="2" as="geometry"/></mxCell>
