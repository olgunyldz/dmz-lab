        <mxCell id="p13_c42" value="7. 200" style="text;html=1;fontSize=9;align=center;verticalAlign=bottom;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="501" y="478" width="178" height="16" as="geometry"/></mxCell>
