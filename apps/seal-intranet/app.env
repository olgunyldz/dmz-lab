CLUSTER=codevo-dmz
NAMESPACE=seal-intranet
IMAGE=dmz-lab/seal-intranet:0.1.0
BUILD_CONTEXT=services/seal-intranet
MANIFEST="manifests/seal-intranet.yaml manifests/ingress.yaml"
ROLLOUT="seal-intranet"
PRE_HOOK=hook.sh
CODE_CM=internal-ca-backend
CODE_FILES="ca.crt=edge/certs/internal-ca.crt"
METRICS="seal-intranet|http|seal-intranet-metrics.seal-intranet.svc:9100|/metrics"
