# Fortuna kimlik zinciri (CGW -> API -> ACL -> LegacyDB) ve SmsOtpCGW mock'u. Kod ConfigMap'te (imaj yok).
CLUSTER=bank-prod
NAMESPACE=channel
CODE_CM=fortuna-code
CODE_FILES="fortuna_stack.py=services/fortuna/fortuna_stack.py tracing.py=shared/tracing.py"
MANIFEST="manifests/fortuna.yaml manifests/fortuna-nodeports.yaml"
ROLLOUT="fortuna-users-cgw fortuna-user-api fortuna-user-acl sms-otp-cgw"
PRE_HOOK=hook.sh
METRICS="fortuna-users-cgw|https|fortuna-users-cgw.channel.svc:8443|/metrics fortuna-user-api|https|fortuna-user-api.channel.svc:8443|/metrics fortuna-user-acl|https|fortuna-user-acl.channel.svc:8443|/metrics sms-otp-cgw|https|sms-otp-cgw.channel.svc:8443|/metrics"
