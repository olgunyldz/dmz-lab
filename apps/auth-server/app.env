# auth-server (Spring Authorization Server). Postgres aynı manifestte; rollout yalnızca auth-server.
CLUSTER=bank-prod
NAMESPACE=auth
IMAGE=dmz-lab/auth-server:0.1.0
BUILD_CONTEXT=services/auth-server
MANIFEST="manifests/auth-server.yaml manifests/ingress.yaml"
ROLLOUT="auth-server"
PRE_HOOK=hook.sh
METRICS="auth-server|http|auth-server.auth.svc:9100|/actuator/prometheus"
