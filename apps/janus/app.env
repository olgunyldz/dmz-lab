# Janus web + mobil: tek manifest, kod ConfigMap'te (imaj yok).
CLUSTER=bank-dmz-prod
NAMESPACE=janus
IMAGE=dmz-lab/janus:0.1.0
BUILD_CONTEXT=services/janus
MANIFEST="manifests/janus.yaml manifests/ingress.yaml"
ROLLOUT="janus-web janus-mobile"
PRE_HOOK=hook.sh
METRICS="janus-web|http|janus-web.janus.svc:8080|/metrics janus-mobile|http|janus-mobile.janus.svc:8080|/metrics"
