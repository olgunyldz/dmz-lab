    {
      "id": 11,
      "type": "timeseries",
      "title": "5xx oranı (servis bazlı)",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(svc_requests_total{status=~\"5..\"}[5m])) / sum by (service) (rate(svc_requests_total[5m])) or vector(0)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Gecikme p50 / p99 (servis bazlı, s)",
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, service) (rate(svc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{service}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(svc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
